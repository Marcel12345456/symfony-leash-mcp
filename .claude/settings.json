{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|clear|resume|compact",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prompt-check.sh", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Grep|Glob|Bash",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/vendor-guard.sh", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/phase-boundary.sh", "timeout": 10 } ] }
    ]
  }
}
