{% extends 'base.html.twig' %}
{% block title %}Log in{% endblock %}
{% block body %}
<h1>Log in</h1>
{% if error %}<p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>{% endif %}
<form method="post" action="{{ path('app_login') }}">
    <label>User <input type="text" name="_username" value="{{ username }}" autocomplete="username" required></label>
    <label>Password <input type="password" name="_password" autocomplete="current-password" required></label>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button type="submit">Log in</button>
</form>
{% endblock %}
