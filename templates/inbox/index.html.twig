{% extends 'base.html.twig' %}
{% block title %}Inbox{% endblock %}
{% block body %}
<h1>Inbox</h1>
{% for item in items %}
    <p><a href="{{ path('inbox_item', {id: item.id}) }}">#{{ item.id }}</a> {{ item.tool }} on {{ item.subjectRef }} by {{ item.callerId }}, {{ item.createdAt|date('Y-m-d H:i') }}</p>
{% else %}
    <p>Nothing waits for you.</p>
{% endfor %}
<p><a href="{{ path('app_logout') }}">Log out</a></p>
{% endblock %}
