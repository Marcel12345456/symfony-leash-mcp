# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
LEASH_WEREWOLF_SECRET=test-werewolf-secret
APPROVER_PASSWORD=approver-test-password
# Agents in tests: Ollama on a closed port, so every live turn fails at once and the deadline path applies.
LEASH_MODEL=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:9
LEASH_TURN_TIMEOUT=2
# Telegram bot calls go to a mock HttpClient (services.yaml when@test); the bridge sends to null://null.
TELEGRAM_DSN=telegram://123:test-token@default?channel=4242
